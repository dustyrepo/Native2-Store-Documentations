---
// Overrides Starlight's <SocialIcons> to add a visible "Store" link before
// the icon row. The default social slot only renders icon-only buttons
// (sr-only label), which is right for a recognizable brand icon like
// Discord but reads as decoration, not a link, for a plain shop link - so
// this one keeps a real visible label instead of hiding it.
import config from 'virtual:starlight/user-config';
import { Icon } from '@astrojs/starlight/components';

const links = config.social || [];
---

<a href="https://native2-store.tebex.store/" target="_blank" rel="noopener" class="store-link">
	<span>Store</span>
	<Icon name="external" size="1em" />
</a>

{
	links.map(({ label, href, icon }) => (
		<a href={href} rel="me" class="sl-flex">
			<span class="sr-only">{label}</span>
			<Icon name={icon} />
		</a>
	))
}

<style>
	@layer starlight.core {
		.store-link {
			display: flex;
			align-items: center;
			gap: 0.35em;
			font-size: var(--sl-text-sm);
			font-weight: 600;
			color: var(--sl-color-text-accent);
			padding: 0.35em 0.85em;
			border: 1px solid var(--sl-color-text-accent);
			border-radius: 999rem;
			text-decoration: none;
			white-space: nowrap;
		}
		.store-link:hover {
			background: var(--sl-color-text-accent);
			color: var(--sl-color-black);
		}
		.store-link :global(svg) {
			width: 0.8em;
			height: 0.8em;
		}
	}
</style>
